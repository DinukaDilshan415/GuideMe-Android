<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.HomeFragment">

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:orientation="vertical"
       android:padding="8dp">

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="horizontal"
           android:paddingVertical="10dp"
           >

           <ImageView
               android:layout_width="30dp"
               android:layout_height="30dp"
               android:src="@drawable/location_on_24px"
               android:clickable="true"
               android:layout_gravity="center"
               />

           <TextView
               android:id="@+id/locationTag"
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:text="Kandy, Sri lanka"
               android:paddingStart="5dp"
               android:textSize="16sp"
               android:layout_weight="1"
               android:layout_gravity="center"
               />

           <ImageView
               android:id="@+id/searchIconOnHome"
               android:layout_width="30dp"
               android:layout_height="30dp"
               android:layout_marginHorizontal="8dp"
               android:src="@drawable/search_24px"
               android:clickable="true"
               android:layout_gravity="center"
               />

           <ImageView
               android:id="@+id/notificationIconOnHome"
               android:layout_width="30dp"
               android:layout_height="30dp"
               android:layout_marginHorizontal="8dp"
               android:src="@drawable/notifications_unread_24px"
               android:clickable="true"
               android:layout_gravity="center"
               />

       </LinearLayout>

       <EditText
           android:id="@+id/textInput_search"
           android:layout_width="match_parent"
           android:layout_height="40dp"
           android:padding="8dp"
           android:layout_marginVertical="5dp"
           android:hint="@string/home_search_hint"
           android:drawableEnd="@drawable/search_24px"
           android:background="@drawable/custom_input_search"
           android:visibility="gone"
           />

       <Button
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Change Location"
           android:textSize="16sp"
           />

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="0dp"
           android:orientation="vertical"
           android:layout_weight="1"
           >

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               android:background="#ffff"
               android:elevation="8dp">

               <include
                   android:id="@+id/category_menu_section"
                   layout="@layout/category_menus" />

           </LinearLayout>

           <LinearLayout
               android:id="@+id/category_fragment_container"
               android:layout_width="match_parent"
               android:layout_height="0dp"
               android:orientation="vertical"
               android:layout_weight="1">

           </LinearLayout>

       </LinearLayout>

   </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/notification_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        app:headerLayout="@layout/notification_center" />

</androidx.drawerlayout.widget.DrawerLayout>