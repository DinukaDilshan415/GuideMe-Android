<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/reviewerImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/sample1"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_shape" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/reviewerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dinuka Dilshan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reviewerLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sri Lanka"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RatingBar
                android:id="@+id/hotel_review_rating"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:progressTint="#FFC107"
                android:rating="4.5"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/review_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_rating"
                android:padding="4dp"
                android:text="4.5"
                android:textColor="@color/md_theme_onPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/review_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="january 2026"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/review_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            android:text="Beautiful hotel with great amenities, comfortable rooms, high security and very helpful staff. We got stranded in Colombo due to the situation in the Middle East and they did their upmost to make our stay enjoyable moving rooms for us and extending our stay so we could use the pool on the day of our departure (big thanks to Charaka). Breakfast was amazing with plenty of choices, and so was our lunch at the bistro on 23rd floor. We also had a lovely iced tea at the Dilmah shop on the 7th floor and really relaxing time at the infinity pool which was surprisingly not busy."
            android:maxLines="5"
            android:ellipsize="end"
            />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>