<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/counter_border"
    android:padding="20dp">

    <ImageView
        android:id="@+id/compass_background"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:src="@drawable/compass_rim" />

    <ImageView
        android:id="@+id/compass_needle"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerInParent="true"
        android:src="@drawable/compass_needle" />

    <TextView
        android:id="@+id/tvHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/compass_background"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="0° North"
        android:textSize="28sp"
        android:textStyle="bold" />
</RelativeLayout>